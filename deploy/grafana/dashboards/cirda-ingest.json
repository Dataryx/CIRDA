{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Ingest Events Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cirda_ingest_events_total[5m]))",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Ingest Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cirda_ingest_errors_total[5m])) / clamp_min(sum(rate(cirda_ingest_events_total[5m])), 1)",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "title": "Ingest Batch Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cirda_ingest_batch_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "id": 4,
      "title": "Kafka Consumer Lag",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(cirda_kafka_consumer_lag)",
          "legendFormat": "lag"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "id": 5,
      "title": "DLQ Messages",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(cirda_ingest_dlq_total[1h]))",
          "legendFormat": "dlq/h"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "id": 6,
      "title": "Active Ingest Workers",
      "type": "stat",
      "targets": [
        {
          "expr": "count(up{job=\"cirda-ingest\"} == 1)",
          "legendFormat": "workers"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["cirda", "ingest"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "CIRDA Ingest",
  "uid": "cirda-ingest",
  "version": 1
}
