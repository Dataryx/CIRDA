# CIRDA environment template — copy to .env and adjust for local dev.
# All variables use the CIRDA_ prefix (see apps/api and apps/ingest-worker settings).

# --- Runtime profile ---
# development | staging | production
CIRDA_APP_ENV=development
# Alias used by seed scripts; must be "local" to run destructive demo seeders
CIRDA_ENV=local

# --- API server ---
CIRDA_HOST=0.0.0.0
CIRDA_PORT=8000
CIRDA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage & messaging ---
# PostgreSQL DSN; omit for in-memory SQLite (dev-lite)
CIRDA_DATABASE_URL=postgresql+asyncpg://cirda:cirda@localhost:5432/cirda
# Force in-memory store even when DATABASE_URL is set
CIRDA_MEMORY_STORE=false
CIRDA_REDIS_URL=redis://localhost:6379/0
# redis | inmemory
CIRDA_EVENT_BUS=inmemory

# --- Calibration thresholds (must satisfy THETA_P < THETA_C) ---
CIRDA_THETA_C=0.62
CIRDA_THETA_P=0.28
CIRDA_C_MIN=0.85
CIRDA_CONFIRMED_REQUIRES_DIRECT_EVIDENCE=true
CIRDA_MIN_TRACE_OBSERVATIONS_FOR_CONFIRMED=3
CIRDA_MAX_INGEST_LAG_SECONDS=3600
CIRDA_CRITICAL_THRESHOLD=high
# Comma-separated entity IDs that always block UNSAFE verdicts
CIRDA_HARD_BLOCKS=
# When true, INDETERMINATE decisions include coverage-gap probe suggestions with expected ΔC.
CIRDA_PROBE_PLANNING_ENABLED=false
# When true (requires planning), POST /decisions/probes/apply lifts channel suppression (not live collectors).
CIRDA_PROBE_EXECUTION_ENABLED=false

# --- Auth ---
# dev | jwt | api_key
CIRDA_AUTH_MODE=dev
CIRDA_JWT_SECRET=dev-secret-change-me
CIRDA_JWT_ISSUER=cirda
CIRDA_JWT_AUDIENCE=cirda-api

# --- Observability ---
CIRDA_LOG_LEVEL=INFO
CIRDA_LOG_JSON=false
CIRDA_OTEL_ENABLED=false
CIRDA_OTEL_ENDPOINT=http://localhost:4317
CIRDA_METRICS_ENABLED=true
CIRDA_RATE_LIMIT_RPM=600

# --- Background jobs (API) ---
CIRDA_SCHEDULER_ENABLED=true
CIRDA_DECAY_JOB_INTERVAL_SECONDS=3600
CIRDA_COVERAGE_JOB_INTERVAL_SECONDS=900
CIRDA_SNAPSHOT_JOB_INTERVAL_SECONDS=86400
CIRDA_RECALIBRATION_JOB_INTERVAL_SECONDS=604800

# --- Decision report footer (shown on every report) ---
CIRDA_DECISION_LIMITATIONS_FOOTER="Limitations: CIRDA decisions reflect observability coverage and inferred dependency structure at the evaluation timestamp."

# --- Ingest worker ---
CIRDA_INGEST_HOST=0.0.0.0
CIRDA_INGEST_PORT=8081
# kafka | inmemory | otlp | file
CIRDA_INGEST_EVENT_BUS=inmemory
CIRDA_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
CIRDA_KAFKA_TOPIC=cirda.evidence.raw
CIRDA_KAFKA_GROUP_ID=cirda-ingest
CIRDA_KAFKA_DLQ_TOPIC=cirda.evidence.dlq
CIRDA_KAFKA_AUTO_FALLBACK=true
# Host clients use EXTERNAL listener :19092 (compose full). In-cluster uses redpanda:9092.
CIRDA_OTLP_LISTEN_HOST=0.0.0.0
CIRDA_OTLP_LISTEN_PORT=4318
CIRDA_FILE_REPLAY_PATH=data/replay.jsonl
CIRDA_FILE_REPLAY_LOOP=false
CIRDA_BATCH_MAX_EVENTS=500
CIRDA_BATCH_MAX_WAIT_MS=200
CIRDA_HEALTH_CHECK_KAFKA=true

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
